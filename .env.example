# CrewAI management environment only. Never commit the real API key.
OPENAI_API_KEY=replace_with_your_openai_api_key
AGRI_CREW_MODEL=openai/gpt-5.6-sol
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# Shared by the two local environments. Replace with a long random value.
AGRI_CARLA_WORKER_TOKEN=replace_with_a_long_random_token

# Fixed same-host loopback endpoint. Non-loopback addresses are rejected.
AGRI_CARLA_WORKER_URL=http://127.0.0.1:8765
AGRI_CARLA_WORKER_AGENTS=EEA
