{
  "enabled": true,
  "provider": "openai_compatible",
  "model": "gpt-5.6-sol",
  "base_url": "https://api.openai.com/v1",
  "api_key_env": "OPENAI_API_KEY",
  "timeout_s": 240,
  "send_temperature": false,
  "max_tokens": 10000,
  "max_tokens_parameter": "max_completion_tokens",
  "reasoning_effort": "medium",
  "include_images": true,
  "image_detail": "high",
  "max_repair_attempts": 2
}
